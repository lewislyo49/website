---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { languages, isLang, ui } from '../../i18n/ui';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = isLang(Astro.params.lang) ? Astro.params.lang : 'en';
const t = ui[lang];
---
<BaseLayout {lang} title={`${t.pioneerTitle} — Lewis Lyo`}>
  <section class="pioneer-page">
    <div><span class="section-index">ORIGINAL CHARACTER / 2020 —</span><h1>{t.pioneerTitle}</h1><p>{t.pioneerBody}</p><p class="status-note">{t.comingSoonBody}</p></div>
    <div class="pioneer-page__mark"><span class="technical-rings"></span><img src="/media/brand/helmet-mark.png" alt={`${t.pioneerTitle} helmet`} /></div>
  </section>
  <SiteFooter {lang} />
</BaseLayout>
