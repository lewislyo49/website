---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { languages, isLang, ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = isLang(Astro.params.lang) ? Astro.params.lang : 'en';
const t = ui[lang];
const aboutCopy: Record<Lang, string[]> = {
  en: [
    "I'm a passionate creator specializing in video editing, visual effects and graphic design. With a foundation in traditional fine art and a lifelong love of anime, comics, games and tokusatsu, I developed a natural interest in visual storytelling and post-production.",
    "Since 2017, I have worked across studios, creator platforms and restaurant brands. I turn abstract ideas into direct, compelling visuals through filming, editing, short-form strategy, Vtuber project planning and graphic design.",
    "Now based in Salem, Oregon, I create social video, photography and graphic systems for Momiji Sushi Restaurants and its associated brands while continuing independent video and VFX work."
  ],
  zh: [
    '我专注于视频剪辑、视觉特效与平面设计。传统美术训练，以及从小对动画、漫画、游戏和特摄的热爱，让我自然地走向视觉叙事与后期制作。',
    '自 2017 年起，我在工作室、创作者平台与餐饮品牌之间持续创作，通过拍摄、剪辑、短视频策略、Vtuber 企划和平面设计，把抽象想法转化为直接而有感染力的视觉。',
    '目前我居住在俄勒冈州 Salem，为 Momiji Sushi Restaurants 及相关品牌制作社交视频、摄影和平面视觉系统，同时继续独立视频与 VFX 创作。'
  ],
  ja: [
    '映像編集、VFX、グラフィックデザインを専門とするクリエイターです。伝統美術の基礎と、幼少期から親しんできたアニメ、漫画、ゲーム、特撮への愛が、映像表現とポストプロダクションへの関心につながりました。',
    '2017年から、スタジオ、クリエイタープラットフォーム、飲食ブランドで制作を続けています。撮影、編集、ショート動画戦略、Vtuber企画、グラフィックを通して、抽象的な発想を伝わるビジュアルへ変換します。',
    '現在はオレゴン州セーラムを拠点に、Momiji Sushi Restaurants と関連ブランドのSNS映像、写真、グラフィックシステムを制作しながら、個人の映像・VFX制作も続けています。'
  ]
};
const experience = [
  ['2023 — PRESENT', 'MOMIJI SUSHI RESTAURANTS', 'Graphic Designer · Video Producer · Photographer'],
  ['2022', 'LINGGAN JUBIAN MEDIA', 'Videographer · Video Editor'],
  ['2021 — 2022', 'ZEYOU HUMAN RESOURCES', 'Short-form Video Intern · Content Operator'],
  ['2020 — 2022', 'FREELANCE & VOLUNTEER PROJECTS', 'Video Editor · Motion Graphics Designer'],
  ['2017 — 2020', 'ANTIQUE ART CENTER', 'Photography · Video Production Intern']
];
---
<BaseLayout {lang} title={`${t.aboutTitle} — Lewis Lyo`}>
  <section class="about-hero">
    <div><span class="section-index">SINCE 2017</span><h1>{t.aboutTitle}</h1></div>
    <img src="/media/brand/helmet-mark.png" alt="Lewis Lyo helmet mark" />
  </section>
  <section class="about-copy">{aboutCopy[lang].map((paragraph) => <p>{paragraph}</p>)}</section>
  <section class="timeline-section">
    <span class="section-index">01</span><h2>{t.experienceTitle}</h2>
    <div class="timeline">{experience.map(([date, employer, role]) => <article><time>{date}</time><h3>{employer}</h3><p>{role}</p></article>)}</div>
  </section>
  <section class="credentials-section">
    <div><span class="section-index">02</span><h2>{t.credentialsTitle}</h2></div>
    <div>
      <p>Associate Degree · Digital Media Art and Design<br />Guangxi College of Education · 2019–2022</p>
      <p>Adobe Certified Professional<br />Video Design · Visual Design · 2021</p>
      <a class="text-link" href="/documents/momiji-recommendation-redacted.pdf" target="_blank">{t.recommendation}</a>
    </div>
  </section>
  <ContactSection {lang} />
  <SiteFooter {lang} />
</BaseLayout>
