---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { languages, isLang, ui } from '../../../i18n/ui';
import { clients, clientLabel } from '../../../lib/catalog';

export function getStaticPaths() {
  return languages.flatMap((lang) => clients.map((client) => ({ params: { lang, client: client.slug } })));
}
const lang = isLang(Astro.params.lang) ? Astro.params.lang : 'en';
const client = Astro.params.client || '';
const t = ui[lang];
const projects = (await getCollection('projects', ({ data }) => data.published && data.client === client)).sort((a, b) => a.data.order - b.data.order);
const title = clientLabel(client);
---
<BaseLayout {lang} title={`${title} — Lewis Lyo`}>
  <section class="page-hero page-hero--compact"><span class="section-index">{t.client}</span><h1>{title}</h1></section>
  <section class="page-section">
    {projects.length ? <div class="project-grid project-grid--featured">{projects.map((project) => <ProjectCard {project} {lang} />)}</div> : <div class="coming-soon"><h2>{t.comingSoon}</h2><p>{t.comingSoonBody}</p></div>}
  </section>
  <SiteFooter {lang} />
</BaseLayout>
