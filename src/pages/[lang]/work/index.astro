---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import ContactSection from '../../../components/ContactSection.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { languages, isLang, ui } from '../../../i18n/ui';
import { videoCategories, graphicCategories, clients } from '../../../lib/catalog';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = isLang(Astro.params.lang) ? Astro.params.lang : 'en';
const t = ui[lang];
const projects = (await getCollection('projects', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
---
<BaseLayout {lang} title={`${t.work} — Lewis Lyo`}>
  <section class="page-hero page-hero--work">
    <span class="section-index">PORTFOLIO / 2026</span>
    <h1>{t.selectedWork}</h1>
    <p>{lang === 'zh' ? '视频、VFX、品牌与平面设计作品。' : lang === 'ja' ? '映像、VFX、ブランド、グラフィックデザイン。' : 'Video, VFX, branding and graphic design.'}</p>
  </section>
  <section class="page-section">
    <h2>{t.featured}</h2>
    <div class="project-grid project-grid--featured">{featured.map((project, index) => <ProjectCard {project} {lang} priority={index < 2} />)}</div>
  </section>
  <section class="index-section">
    <div><span class="section-index">01</span><h2>{t.byDiscipline}</h2></div>
    <div class="index-columns">
      <div>{videoCategories.map((item, index) => <a href={`/${lang}/work/category/${item.slug}/`}><span>0{index + 1}</span>{item.label[lang]}</a>)}</div>
      <div>{graphicCategories.map((item, index) => <a href={`/${lang}/work/category/${item.slug}/`}><span>0{index + 7}</span>{item.label[lang]}</a>)}</div>
    </div>
  </section>
  <section class="client-index">
    <span class="section-index">02</span><h2>{t.byClient}</h2>
    <div>{clients.map((client) => <a href={`/${lang}/clients/${client.slug}/`}>{client.label}</a>)}</div>
  </section>
  <ContactSection {lang} />
  <SiteFooter {lang} />
</BaseLayout>
