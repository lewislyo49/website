---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../../components/ProjectCard.astro';
import VtuberCard from '../../../../components/VtuberCard.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import { languages, isLang, ui } from '../../../../i18n/ui';
import { categories, categoryLabel } from '../../../../lib/catalog';

export function getStaticPaths() {
  return languages.flatMap((lang) => categories.map((category) => ({ params: { lang, category: category.slug } })));
}
const lang = isLang(Astro.params.lang) ? Astro.params.lang : 'en';
const category = Astro.params.category || '';
const t = ui[lang];
const projects = (await getCollection('projects', ({ data }) => data.published && (data.categories as string[]).includes(category))).sort((a, b) => a.data.order - b.data.order);
const title = categoryLabel(category, lang);
---
<BaseLayout {lang} title={`${title} — Lewis Lyo`}>
  <section class="page-hero page-hero--compact"><span class="section-index">{t.work} / {title}</span><h1>{title}</h1></section>
  <section class="page-section">
    {projects.length || category === 'non-profit' ? (
      <div class="project-grid project-grid--featured">
        {projects.map((project) => <ProjectCard {project} {lang} />)}
        {category === 'non-profit' && <VtuberCard {lang} />}
      </div>
    ) : <div class="coming-soon"><img src="/media/brand/helmet-mark.png" alt="" /><h2>{t.comingSoon}</h2><p>{t.comingSoonBody}</p></div>}
  </section>
  <SiteFooter {lang} />
</BaseLayout>
