---
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/900.css';
import '@fontsource/noto-serif-jp/400.css';
import '@fontsource/noto-serif-jp/600.css';
import '@fontsource/noto-serif-jp/900.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  overlayHeader?: boolean;
}
const { lang, title, description = 'Video, VFX and graphic design portfolio by Lewis Lyo.', overlayHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030405" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/media/brand/helmet-mark.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader {lang} overlay={overlayHeader} />
    <main id="main"><slot /></main>
  </body>
</html>
